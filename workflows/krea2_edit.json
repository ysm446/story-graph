{
  "_comment": "Krea2 Turbo の参照画像あり(場面の挿絵)。同梱 ComfyUI の公式テンプレート「Image Style Reference (Krea-2 Turbo)」の配線(TextEncodeQwenImageEditPlus → FluxKontextMultiReferenceLatentMethod(index_timestep_zero) → CFGGuider)を API 形式に写し、人物を保つ LoRA(\"9\" identity edit、必須)と画風 LoRA(\"13\"、values に lora が無ければ外れる _optional)を挟んだもの。参照画像は {{ref_image_1}}..{{ref_image_3}} で、渡した枚数より後ろの LoadImage(11, 12)と image2/image3 の配線は build 時に外す。公式の用途は 1 枚の style reference なので、2〜3 人の同一性保持は未検証。",
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" } },
  "20": { "class_type": "CLIPLoader", "inputs": { "clip_name": "{{clip}}", "type": "krea2", "device": "default" } },
  "21": { "class_type": "VAELoader", "inputs": { "vae_name": "{{vae}}" } },
  "9": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["1", 0], "lora_name": "{{identity_lora}}", "strength_model": "{{identity_strength}}" }
  },
  "13": {
    "_optional": "lora",
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["9", 0], "lora_name": "{{lora}}", "strength_model": "{{lora_strength}}" }
  },
  "2": {
    "class_type": "ModelSamplingFlux",
    "inputs": {
      "model": ["13", 0],
      "max_shift": "{{max_shift}}",
      "base_shift": "{{base_shift}}",
      "width": "{{width}}",
      "height": "{{height}}"
    }
  },
  "10": { "class_type": "LoadImage", "inputs": { "image": "{{ref_image_1}}", "upload": "image" } },
  "11": { "class_type": "LoadImage", "inputs": { "image": "{{ref_image_2}}", "upload": "image" } },
  "12": { "class_type": "LoadImage", "inputs": { "image": "{{ref_image_3}}", "upload": "image" } },
  "3": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "inputs": {
      "clip": ["20", 0],
      "vae": ["21", 0],
      "prompt": "{{positive}}",
      "image1": ["10", 0],
      "image2": ["11", 0],
      "image3": ["12", 0]
    }
  },
  "26": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "inputs": { "conditioning": ["3", 0], "reference_latents_method": "index_timestep_zero" }
  },
  "4": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["26", 0] } },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 }
  },
  "22": { "class_type": "CFGGuider", "inputs": { "model": ["2", 0], "positive": ["26", 0], "negative": ["4", 0], "cfg": "{{cfg}}" } },
  "23": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "{{sampler}}" } },
  "24": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["2", 0], "scheduler": "{{scheduler}}", "steps": "{{steps}}", "denoise": 1.0 }
  },
  "25": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{seed}}" } },
  "6": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["25", 0],
      "guider": ["22", 0],
      "sampler": ["23", 0],
      "sigmas": ["24", 0],
      "latent_image": ["5", 0]
    }
  },
  "7": { "class_type": "VAEDecode", "inputs": { "samples": ["6", 0], "vae": ["21", 0] } },
  "8": { "class_type": "SaveImage", "inputs": { "images": ["7", 0], "filename_prefix": "{{filename_prefix}}" } }
}
